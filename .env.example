# ===== Google Sheets =====
# ID da planilha (fica na URL: docs.google.com/spreadsheets/d/ESTE_TRECHO/edit)
GOOGLE_SHEET_ID=

# Nome da aba com as pendencias
GOOGLE_SHEET_TAB=Pendencias

# Credenciais da conta de servico (baixadas do Google Cloud Console em JSON).
# Cole o conteudo inteiro do JSON em UMA LINHA SO aqui.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== Painel =====
# Chave compartilhada que o painel HTML usa para ler/gravar pendencias.
# Distribua essa chave só para quem deve acessar o painel (ex: seu time financeiro).
PANEL_TOKEN=troque-isto-por-uma-chave-forte

# ===== Servidor =====
PORT=3000
